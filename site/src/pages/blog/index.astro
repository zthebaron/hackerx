---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<StarlightPage
  frontmatter={{
    title: 'Blog',
    description: 'Field notes on shipping UI 100x faster with Claude Code. Patterns, prompts, and the verification loop.',
    template: 'doc',
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p class="hx-blog-intro">
    Field notes on shipping UI with Claude Code. The vocabulary, the prompts, the verification loop. Stop saying "make it better." Pick a pattern.
  </p>

  <ul class="hx-blog-list">
    {posts.map((post) => (
      <li class="hx-blog-item">
        <a href={`/blog/${post.id}/`} class="hx-blog-link">
          <header>
            <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
            {post.data.tags.length > 0 && (
              <span class="hx-blog-tags">
                {post.data.tags.slice(0, 3).map((t) => <span class="hx-blog-tag">{t}</span>)}
              </span>
            )}
          </header>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <span class="hx-blog-more">Read →</span>
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p class="hx-blog-empty">No posts yet. Run <code>pnpm sync</code> after dropping a `.mdx` file in <code>src/content/blog/</code>.</p>
  )}
</StarlightPage>

<style>
  .hx-blog-intro {
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
    max-width: 56ch;
  }
  .hx-blog-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hx-blog-item {
    margin: 0;
  }
  .hx-blog-link {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .hx-blog-link:hover {
    border-color: var(--sl-color-text-accent);
    transform: translateY(-1px);
  }
  .hx-blog-link header {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hx-blog-tags {
    display: flex;
    gap: 0.375rem;
  }
  .hx-blog-tag {
    padding: 0.0625rem 0.4rem;
    background: var(--sl-color-bg-inline-code);
    border-radius: 0.25rem;
    color: var(--sl-color-text-accent);
    text-transform: lowercase;
  }
  .hx-blog-link h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .hx-blog-link p {
    margin: 0 0 0.5rem;
    color: var(--sl-color-gray-2);
  }
  .hx-blog-more {
    font-size: 0.85rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .hx-blog-empty {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
  }
</style>

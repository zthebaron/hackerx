---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<StarlightPage
  frontmatter={{
    title: post.data.title,
    description: post.data.description,
    template: 'doc',
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 3 },
  }}
>
  <p class="hx-post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
    <span> · </span>
    <span>{post.data.author}</span>
    {post.data.tags.length > 0 && (
      <>
        <span> · </span>
        <span class="hx-post-tags">
          {post.data.tags.map((t) => <span class="hx-post-tag">{t}</span>)}
        </span>
      </>
    )}
  </p>

  <Content />

  <hr />

  <p class="hx-post-cta">
    <strong>Want all of this in your repo?</strong>
    Run <code>npx hackerx init</code> — drops <code>CLAUDE.md</code> and <code>.claude/skills/ui-pattern-picker/</code> into your project. Open Claude Code. Watch the next vague request get three options.
  </p>

  <p class="hx-post-back">
    <a href="/blog/">← Back to blog</a>
  </p>
</StarlightPage>

<style>
  .hx-post-meta {
    margin: -0.5rem 0 1.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hx-post-tags {
    display: inline-flex;
    gap: 0.375rem;
  }
  .hx-post-tag {
    padding: 0.0625rem 0.4rem;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-text-accent);
    border-radius: 0.25rem;
  }
  .hx-post-cta {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 0.5rem;
  }
  .hx-post-back {
    margin-top: 2rem;
    font-size: 0.9rem;
  }
</style>

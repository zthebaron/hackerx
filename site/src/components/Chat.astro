---
/**
 * Floating chatbot launcher rendered into the footer on every page.
 * - /api/chat (Anthropic Claude Haiku 4.5) for streaming text.
 * - /api/tts (ElevenLabs) for the speaker / "Listen" feature.
 *
 * Cluster has two buttons: a global speaker toggle (auto-speak on/off) and the
 * chat launcher. Inside the panel: voice selector chips for Emily / Adam / Rachel.
 */
---

<div id="hx-chat-root" data-state="closed" data-autospeak="off">
  <div class="hx-cluster">
    <button
      type="button"
      id="hx-autospeak-toggle"
      class="hx-cluster-btn hx-speaker-btn"
      aria-label="Toggle automatic voice playback for replies"
      data-state="off"
      title="Auto-read replies aloud"
    >
      <svg class="hx-speaker-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
      </svg>
      <svg class="hx-speaker-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
        <line x1="22" y1="9" x2="16" y2="15"/>
        <line x1="16" y1="9" x2="22" y2="15"/>
      </svg>
    </button>

    <button type="button" id="hx-chat-launcher" class="hx-cluster-btn hx-chat-btn" aria-label="Ask the HackerX assistant" aria-expanded="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Ask Claude</span>
    </button>
  </div>

  <section id="hx-chat-panel" role="dialog" aria-label="HackerX assistant" aria-modal="false" hidden>
    <header class="hx-panel-head">
      <div class="hx-panel-title">
        <span class="hx-panel-orb" aria-hidden="true"></span>
        <strong>HackerX</strong>
        <span class="hx-panel-sub">assistant</span>
      </div>

      <div class="hx-voice-row" role="radiogroup" aria-label="Voice for spoken replies">
        <button type="button" class="hx-voice" data-voice="Lucy" role="radio" aria-checked="true" title="Lucy — default voice">L</button>
        <button type="button" class="hx-voice" data-voice="Adam" role="radio" aria-checked="false" title="Adam — deep narrator">A</button>
        <button type="button" class="hx-voice" data-voice="Rachel" role="radio" aria-checked="false" title="Rachel — calm">R</button>
      </div>

      <button type="button" class="hx-panel-close" id="hx-chat-close" aria-label="Close chat">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="hx-log" id="hx-chat-log" role="log" aria-live="polite" aria-label="Chat messages"></div>

    <form class="hx-form" id="hx-chat-form">
      <button
        type="button"
        id="hx-mic"
        class="hx-mic"
        data-state="idle"
        aria-label="Record a voice message"
        title="Record a voice message"
      >
        <svg class="hx-mic-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="2" width="6" height="12" rx="3"/>
          <path d="M5 10v2a7 7 0 0 0 14 0v-2"/>
          <line x1="12" y1="19" x2="12" y2="22"/>
          <line x1="8" y1="22" x2="16" y2="22"/>
        </svg>
        <svg class="hx-mic-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-6.22-8.56"/>
        </svg>
        <svg class="hx-mic-stop" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="4" y="4" width="16" height="16" rx="2"/>
        </svg>
        <span class="hx-mic-time" id="hx-mic-time" hidden>0:00</span>
      </button>
      <label class="hx-input-wrap">
        <span class="sr-only">Your question</span>
        <textarea
          id="hx-chat-input"
          name="message"
          rows="1"
          placeholder="Ask the HackerX assistant…"
          autocomplete="off"
          required
          maxlength="4000"
        ></textarea>
      </label>
      <button type="submit" class="hx-send" aria-label="Send">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <footer class="hx-foot">
      <span class="hx-foot-meta">Claude Haiku 4.5 · ElevenLabs</span>
      <button type="button" class="hx-clear" id="hx-chat-clear">Clear</button>
    </footer>
  </section>
</div>

<style>
  #hx-chat-root {
    position: fixed;
    inset: auto 1rem 1rem auto;
    z-index: 9999;
    font-family: var(--__sl-font-system, system-ui), sans-serif;
    color: var(--sl-color-text);
  }

  /* ─── Launcher cluster ──────────────────────────────────────── */
  .hx-cluster {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--sl-color-bg);
    padding: 0.3rem;
    border-radius: 999px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--sl-color-gray-5);
    transition: opacity 200ms ease;
  }
  #hx-chat-root[data-state='open'] .hx-cluster {
    opacity: 0;
    pointer-events: none;
  }
  .hx-cluster-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    background: transparent;
    color: var(--sl-color-text);
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .hx-cluster-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .hx-speaker-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    justify-content: center;
    color: var(--sl-color-gray-3);
  }
  .hx-speaker-btn:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-bg-inline-code);
  }
  .hx-speaker-btn[data-state='on'] {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-text-accent);
  }
  .hx-speaker-on { display: none; }
  .hx-speaker-off { display: inline; }
  .hx-speaker-btn[data-state='on'] .hx-speaker-on { display: inline; }
  .hx-speaker-btn[data-state='on'] .hx-speaker-off { display: none; }

  .hx-chat-btn {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }
  .hx-chat-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
  }

  /* ─── Panel ─────────────────────────────────────────────────── */
  #hx-chat-panel {
    width: 400px;
    max-width: calc(100vw - 2rem);
    height: 580px;
    max-height: calc(100vh - 2rem);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-origin: bottom right;
    animation: hx-pop 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  #hx-chat-panel[hidden] { display: none; }
  @keyframes hx-pop {
    from { opacity: 0; transform: scale(0.92) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* ─── Header ────────────────────────────────────────────────── */
  .hx-panel-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.5rem;
    align-items: center;
    padding: 0.7rem 0.85rem;
    background: linear-gradient(180deg, var(--sl-color-bg-sidebar), var(--sl-color-bg));
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .hx-panel-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .hx-panel-orb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sl-color-text-accent);
    box-shadow: 0 0 12px var(--sl-color-text-accent);
    animation: hx-orb-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hx-orb-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }
  .hx-panel-sub {
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    font-weight: 500;
  }

  /* Voice selector */
  .hx-voice-row {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    background: var(--sl-color-gray-6);
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
  }
  .hx-voice {
    width: 22px;
    height: 22px;
    background: transparent;
    color: var(--sl-color-gray-3);
    border: 0;
    border-radius: 50%;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 120ms ease, background 120ms ease;
  }
  .hx-voice:hover { color: var(--sl-color-text); }
  .hx-voice[aria-checked='true'] {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }

  .hx-panel-close {
    width: 26px;
    height: 26px;
    background: transparent;
    border: 0;
    color: var(--sl-color-gray-3);
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hx-panel-close:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
  }

  /* ─── Log ───────────────────────────────────────────────────── */
  .hx-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    scroll-behavior: smooth;
  }
  .hx-log::-webkit-scrollbar { width: 6px; }
  .hx-log::-webkit-scrollbar-thumb { background: var(--sl-color-gray-5); border-radius: 3px; }

  .hx-empty {
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    padding: 0.5rem 0;
  }
  .hx-empty-h {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }
  .hx-empty-h em {
    font-style: normal;
    color: var(--sl-color-text-accent);
  }
  .hx-suggest-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hx-suggest {
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.75rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font: inherit;
    font-size: 0.825rem;
    color: var(--sl-color-text);
    cursor: pointer;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .hx-suggest:hover {
    border-color: var(--sl-color-text-accent);
    transform: translateY(-1px);
  }
  .hx-suggest-icon {
    color: var(--sl-color-text-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Messages */
  .hx-msg {
    max-width: 92%;
    padding: 0.6rem 0.8rem;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .hx-msg.user {
    align-self: flex-end;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border-bottom-right-radius: 0.15rem;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.18);
  }
  .hx-msg.assistant {
    align-self: flex-start;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-left-radius: 0.15rem;
  }
  .hx-msg.assistant pre {
    margin: 0.5rem 0;
    padding: 0.55rem 0.75rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.78rem;
    overflow-x: auto;
    white-space: pre;
  }
  .hx-msg.assistant code:not(pre code) {
    padding: 1px 5px;
    background: var(--sl-color-bg-inline-code);
    border-radius: 3px;
    font-family: var(--__sl-font-mono);
    font-size: 0.85em;
  }
  .hx-msg.assistant a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hx-msg p { margin: 0 0 0.5rem; }
  .hx-msg p:last-child { margin-bottom: 0; }
  .hx-msg.error {
    align-self: flex-start;
    background: transparent;
    border: 1px dashed #b91c1c;
    color: #ef4444;
    font-size: 0.8rem;
  }
  .hx-cur {
    display: inline-block;
    width: 0.45em;
    height: 1em;
    background: var(--sl-color-text-accent);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: hx-blink 1s steps(2) infinite;
  }
  @keyframes hx-blink { 50% { opacity: 0; } }

  /* Per-message speaker icon (icon-only) */
  .hx-msg-tools {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .hx-listen {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    color: var(--sl-color-gray-3);
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    transition: all 120ms ease;
  }
  .hx-listen:hover {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-gray-5);
  }
  .hx-listen[data-state='loading'] svg { animation: hx-spin 1s linear infinite; }
  .hx-listen[data-state='playing'] {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-bg-inline-code);
    border-color: var(--sl-color-text-accent);
  }
  .hx-listen[data-disabled] { cursor: not-allowed; opacity: 0.6; }
  @keyframes hx-spin { to { transform: rotate(360deg); } }

  /* ─── Form ──────────────────────────────────────────────────── */
  .hx-form {
    display: flex;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    border-top: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
  }
  .hx-input-wrap { flex: 1; }
  .hx-form textarea {
    width: 100%;
    min-height: 38px;
    max-height: 120px;
    padding: 0.55rem 0.75rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.875rem;
    resize: none;
    line-height: 1.45;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  .hx-form textarea:focus {
    outline: none;
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 0 0 3px var(--sl-color-bg-inline-code);
  }
  .hx-send {
    align-self: stretch;
    width: 38px;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 100ms ease, opacity 100ms ease;
  }
  .hx-send:hover { transform: scale(1.04); }
  .hx-send:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Microphone (voice-in) ───────────────────────────────────── */
  .hx-mic {
    align-self: stretch;
    min-width: 38px;
    padding: 0 0.5rem;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: all 120ms ease;
    position: relative;
  }
  .hx-mic:hover {
    color: var(--sl-color-text);
    border-color: var(--sl-color-text-accent);
  }
  .hx-mic:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .hx-mic-icon { display: inline; }
  .hx-mic-spin, .hx-mic-stop { display: none; }
  .hx-mic-time {
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hx-mic[data-state='recording'] {
    background: #b91c1c;
    color: #ffffff;
    border-color: #ef4444;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: hx-mic-pulse 1.6s ease-out infinite;
  }
  .hx-mic[data-state='recording'] .hx-mic-icon { display: none; }
  .hx-mic[data-state='recording'] .hx-mic-stop { display: inline; }
  .hx-mic[data-state='recording'] .hx-mic-time {
    display: inline;
    color: #ffffff;
  }
  @keyframes hx-mic-pulse {
    0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55); }
    70% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
    100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  .hx-mic[data-state='transcribing'] {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }
  .hx-mic[data-state='transcribing'] .hx-mic-icon { display: none; }
  .hx-mic[data-state='transcribing'] .hx-mic-spin {
    display: inline;
    animation: hx-spin 1s linear infinite;
  }

  .hx-mic[data-state='denied'] {
    color: #dc2626;
    border-color: #dc2626;
    cursor: not-allowed;
  }
  .hx-mic[data-disabled] { cursor: not-allowed; opacity: 0.6; }

  .hx-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.85rem;
    background: var(--sl-color-bg-sidebar);
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }
  .hx-foot-meta { font-family: var(--__sl-font-mono); }
  .hx-clear {
    background: transparent;
    border: 0;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    text-decoration: underline;
    font: inherit;
    font-size: 0.7rem;
  }
  .hx-clear:hover { color: var(--sl-color-text); }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 640px) {
    #hx-chat-root { inset: auto 0.6rem 0.6rem 0.6rem; }
    #hx-chat-panel {
      width: calc(100vw - 1.2rem);
      height: calc(100vh - 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hx-panel-orb, .hx-cur { animation: none; }
    #hx-chat-panel { animation: none; }
  }
</style>

<script>
  (() => {
    const rootEl = document.getElementById('hx-chat-root') as HTMLElement | null;
    const launcherEl = document.getElementById('hx-chat-launcher') as HTMLButtonElement | null;
    const autospeakEl = document.getElementById('hx-autospeak-toggle') as HTMLButtonElement | null;
    const panelEl = document.getElementById('hx-chat-panel') as HTMLElement | null;
    const closeEl = document.getElementById('hx-chat-close') as HTMLButtonElement | null;
    const logEl = document.getElementById('hx-chat-log') as HTMLElement | null;
    const formEl = document.getElementById('hx-chat-form') as HTMLFormElement | null;
    const inputEl = document.getElementById('hx-chat-input') as HTMLTextAreaElement | null;
    const clearEl = document.getElementById('hx-chat-clear') as HTMLButtonElement | null;
    const micEl = document.getElementById('hx-mic') as HTMLButtonElement | null;
    const micTimeEl = document.getElementById('hx-mic-time') as HTMLElement | null;

    if (!rootEl || !launcherEl || !autospeakEl || !panelEl || !closeEl || !logEl || !formEl || !inputEl || !clearEl || !micEl || !micTimeEl) return;
    const root = rootEl, launcher = launcherEl, autospeak = autospeakEl, panel = panelEl;
    const closeBtn = closeEl, log = logEl, form = formEl, input = inputEl, clearBtn = clearEl;
    const mic = micEl, micTime = micTimeEl;

    const HISTORY_KEY = 'hx_chat_history_v1';
    const VOICE_KEY = 'hx_voice';
    const AUTOSPEAK_KEY = 'hx_autospeak';
    const VOICES = ['Lucy', 'Adam', 'Rachel'] as const;

    type Msg = { role: 'user' | 'assistant'; content: string };
    let history: Msg[] = [];
    let inFlight: AbortController | null = null;

    let voice: string = (() => {
      try {
        const v = localStorage.getItem(VOICE_KEY);
        return VOICES.includes(v as typeof VOICES[number]) ? v! : 'Lucy';
      } catch { return 'Lucy'; }
    })();

    let autospeakOn: boolean = (() => {
      try { return localStorage.getItem(AUTOSPEAK_KEY) === '1'; }
      catch { return false; }
    })();

    function setVoice(v: string) {
      voice = v;
      try { localStorage.setItem(VOICE_KEY, v); } catch {}
      panel.querySelectorAll<HTMLButtonElement>('.hx-voice').forEach((b) => {
        b.setAttribute('aria-checked', b.dataset.voice === v ? 'true' : 'false');
      });
    }

    function setAutospeak(on: boolean) {
      autospeakOn = on;
      try { localStorage.setItem(AUTOSPEAK_KEY, on ? '1' : '0'); } catch {}
      autospeak.dataset.state = on ? 'on' : 'off';
      autospeak.title = on ? 'Auto-read replies aloud (on — click to mute)' : 'Auto-read replies aloud (off — click to enable)';
      root.dataset.autospeak = on ? 'on' : 'off';
    }

    setVoice(voice);
    setAutospeak(autospeakOn);

    panel.querySelectorAll<HTMLButtonElement>('.hx-voice').forEach((b) => {
      b.addEventListener('click', () => setVoice(b.dataset.voice ?? 'Emily'));
    });
    autospeak.addEventListener('click', () => setAutospeak(!autospeakOn));

    function loadHistory() {
      try {
        const raw = sessionStorage.getItem(HISTORY_KEY);
        if (raw) history = JSON.parse(raw);
      } catch { history = []; }
    }

    function saveHistory() {
      try { sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-20))); }
      catch {}
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    function renderMarkdown(text: string): string {
      const blocks: string[] = [];
      let working = text.replace(/```([\w-]*)\n([\s\S]*?)```/g, (_m, _lang, code) => {
        const i = blocks.length;
        blocks.push(`<pre><code>${escapeHtml(code)}</code></pre>`);
        return ` BLOCK${i} `;
      });
      working = escapeHtml(working);
      working = working.replace(/`([^`]+)`/g, (_m, code) => `<code>${code}</code>`);
      working = working.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g, (_m, label, href) => {
        const safe = href.startsWith('http') ? `${href}" target="_blank" rel="noopener` : href;
        return `<a href="${safe}">${label}</a>`;
      });
      working = working.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      working = working.replace(/\n\n+/g, '</p><p>').replace(/\n/g, '<br/>');
      working = `<p>${working}</p>`;
      working = working.replace(/ BLOCK(\d+) /g, (_m, i) => blocks[Number(i)] ?? '');
      return working;
    }

    function listenButtonHTML(): string {
      return `<button type="button" class="hx-listen" data-listen aria-label="Read this aloud" data-state="idle">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
      </button>`;
    }

    function appendListen(messageEl: HTMLElement, text: string) {
      const wrap = document.createElement('div');
      wrap.className = 'hx-msg-tools';
      wrap.innerHTML = listenButtonHTML();
      const btn = wrap.querySelector<HTMLButtonElement>('[data-listen]');
      if (btn) btn.dataset.text = text;
      messageEl.appendChild(wrap);
      return btn;
    }

    function emptyStateHTML(): string {
      return `<div class="hx-empty" data-empty>
        <p class="hx-empty-h">Ask <em>anything</em> about the patterns, prompts, or workflow.</p>
        <ul class="hx-suggest-list">
          <li><button type="button" class="hx-suggest" data-suggest="What pattern fits a settings page that feels cluttered?">
            <svg class="hx-suggest-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>What pattern fits a cluttered settings page?</span>
          </button></li>
          <li><button type="button" class="hx-suggest" data-suggest="How do I install the ui-pattern-picker skill?">
            <svg class="hx-suggest-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>How do I install the ui-pattern-picker skill?</span>
          </button></li>
          <li><button type="button" class="hx-suggest" data-suggest="Give me the 8-step OS as a paste-into-CLAUDE.md block.">
            <svg class="hx-suggest-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>Give me the 8-step OS as a CLAUDE.md block.</span>
          </button></li>
        </ul>
      </div>`;
    }

    function rerender() {
      log.innerHTML = '';
      if (history.length === 0) {
        log.innerHTML = emptyStateHTML();
        return;
      }
      for (const m of history) {
        const el = document.createElement('div');
        el.className = `hx-msg ${m.role}`;
        el.innerHTML = m.role === 'assistant' ? renderMarkdown(m.content) : escapeHtml(m.content);
        if (m.role === 'assistant') appendListen(el, m.content);
        log.appendChild(el);
      }
      log.scrollTop = log.scrollHeight;
    }

    let activeAudio: HTMLAudioElement | null = null;
    let activeButton: HTMLButtonElement | null = null;

    function setBtnState(btn: HTMLButtonElement, state: 'idle' | 'loading' | 'playing') {
      btn.dataset.state = state;
      if (state === 'idle') delete btn.dataset.disabled;
      else if (state === 'loading') btn.dataset.disabled = '';
    }

    function stopActive() {
      if (activeAudio) {
        try { activeAudio.pause(); activeAudio.src = ''; } catch {}
        activeAudio = null;
      }
      if (activeButton) {
        setBtnState(activeButton, 'idle');
        activeButton = null;
      }
    }

    async function speak(button: HTMLButtonElement) {
      const text = button.dataset.text;
      if (!text) return;
      if (button === activeButton) { stopActive(); return; }
      stopActive();

      setBtnState(button, 'loading');

      try {
        const res = await fetch('/api/tts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text, voice }),
        });
        if (res.status === 503) {
          setBtnState(button, 'idle');
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const audio = new Audio(url);
        activeAudio = audio;
        activeButton = button;
        setBtnState(button, 'playing');
        audio.addEventListener('ended', () => {
          URL.revokeObjectURL(url);
          if (activeButton === button) {
            setBtnState(button, 'idle');
            activeAudio = null; activeButton = null;
          }
        });
        audio.addEventListener('error', () => {
          URL.revokeObjectURL(url);
          if (activeButton === button) {
            setBtnState(button, 'idle');
            activeAudio = null; activeButton = null;
          }
        });
        await audio.play();
      } catch (err) {
        console.error('tts', err);
        setBtnState(button, 'idle');
      }
    }

    log.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const listenBtn = t.closest('[data-listen]') as HTMLButtonElement | null;
      if (listenBtn) { speak(listenBtn); return; }
      const suggest = t.closest('.hx-suggest') as HTMLElement | null;
      if (suggest) {
        const text = suggest.getAttribute('data-suggest') ?? '';
        if (text) {
          input.value = text;
          form.requestSubmit();
        }
      }
    });

    function open() {
      panel.hidden = false;
      root.dataset.state = 'open';
      launcher.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => input.focus());
    }
    function close() {
      panel.hidden = true;
      root.dataset.state = 'closed';
      launcher.setAttribute('aria-expanded', 'false');
      if (inFlight) inFlight.abort();
      stopActive();
      launcher.focus();
    }

    launcher.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.state === 'open') close();
    });

    clearBtn.addEventListener('click', () => {
      if (inFlight) inFlight.abort();
      stopActive();
      history = [];
      saveHistory();
      rerender();
      input.focus();
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || inFlight) return;

      history.push({ role: 'user', content: text });
      saveHistory();
      input.value = '';
      input.style.height = 'auto';

      const empty = log.querySelector('[data-empty]');
      if (empty) empty.remove();

      const userEl = document.createElement('div');
      userEl.className = 'hx-msg user';
      userEl.textContent = text;
      log.appendChild(userEl);

      const assistantEl = document.createElement('div');
      assistantEl.className = 'hx-msg assistant';
      assistantEl.innerHTML = '<p><span class="hx-cur"></span></p>';
      log.appendChild(assistantEl);
      log.scrollTop = log.scrollHeight;

      inFlight = new AbortController();
      let assistantText = '';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
          signal: inFlight.signal,
        });

        if (res.status === 503) {
          assistantEl.classList.add('error');
          assistantEl.textContent = 'Chat is not configured on this deployment. Set ANTHROPIC_API_KEY to enable.';
          history.pop();
          saveHistory();
          inFlight = null;
          return;
        }
        if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          let idx: number;
          while ((idx = buffer.indexOf('\n\n')) !== -1) {
            const event = buffer.slice(0, idx);
            buffer = buffer.slice(idx + 2);
            const line = event.split('\n').find((l) => l.startsWith('data: '));
            if (!line) continue;
            const payload = line.slice(6).trim();
            if (payload === '[DONE]') {
              if (assistantText) history.push({ role: 'assistant', content: assistantText });
              saveHistory();
              continue;
            }
            try {
              const parsed = JSON.parse(payload) as { text?: string; error?: string };
              if (parsed.text) {
                assistantText += parsed.text;
                assistantEl.innerHTML = renderMarkdown(assistantText) + '<span class="hx-cur"></span>';
                log.scrollTop = log.scrollHeight;
              } else if (parsed.error) {
                throw new Error(parsed.error);
              }
            } catch (parseErr) {
              console.warn('chat parse', parseErr);
            }
          }
        }
        assistantEl.innerHTML = renderMarkdown(assistantText);
        if (assistantText) {
          const listen = appendListen(assistantEl, assistantText);
          if (autospeakOn && listen) {
            // Auto-trigger TTS for the new message
            setTimeout(() => speak(listen), 200);
          }
        }
      } catch (err) {
        if ((err as Error).name === 'AbortError') {
          assistantEl.innerHTML = renderMarkdown(assistantText) || '<em>cancelled</em>';
        } else {
          console.error(err);
          assistantEl.classList.add('error');
          assistantEl.textContent = 'Could not reach the chat backend. Try again in a moment.';
          history.pop();
          saveHistory();
        }
      } finally {
        inFlight = null;
      }
    });

    /* ── Voice-in (MediaRecorder → /api/transcribe → textarea) ── */
    const MAX_REC_SECS = 60;
    let recorder: MediaRecorder | null = null;
    let recChunks: Blob[] = [];
    let recStream: MediaStream | null = null;
    let recStartedAt = 0;
    let recTimerId: number | null = null;

    function setMicState(state: 'idle' | 'recording' | 'transcribing' | 'denied') {
      mic.dataset.state = state;
      if (state === 'recording' || state === 'transcribing') mic.dataset.disabled = '';
      else delete mic.dataset.disabled;
      micTime.hidden = state !== 'recording';
    }

    function fmtClock(s: number): string {
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${m}:${String(r).padStart(2, '0')}`;
    }

    function updateRecTimer() {
      const elapsed = Math.floor((Date.now() - recStartedAt) / 1000);
      micTime.textContent = fmtClock(elapsed);
      if (elapsed >= MAX_REC_SECS) stopRec();
    }

    async function startRec() {
      if (recorder) return;
      if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') {
        setMicState('denied');
        mic.title = 'Voice input not supported in this browser';
        return;
      }
      try {
        recStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (err) {
        console.warn('mic permission denied', err);
        setMicState('denied');
        mic.title = 'Microphone permission denied. Allow access in your browser settings.';
        setTimeout(() => { setMicState('idle'); mic.title = 'Record a voice message'; }, 2200);
        return;
      }

      recChunks = [];
      const mime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
        ? 'audio/webm;codecs=opus'
        : MediaRecorder.isTypeSupported('audio/webm')
        ? 'audio/webm'
        : '';
      recorder = mime ? new MediaRecorder(recStream, { mimeType: mime }) : new MediaRecorder(recStream);
      recorder.addEventListener('dataavailable', (e) => {
        if (e.data && e.data.size > 0) recChunks.push(e.data);
      });
      recorder.addEventListener('stop', async () => {
        const tracks = recStream?.getTracks() ?? [];
        for (const t of tracks) t.stop();
        recStream = null;
        if (recTimerId !== null) {
          clearInterval(recTimerId);
          recTimerId = null;
        }
        const blob = new Blob(recChunks, { type: recorder?.mimeType || 'audio/webm' });
        recorder = null;
        recChunks = [];
        if (blob.size < 800) {
          setMicState('idle');
          return;
        }
        await transcribe(blob);
      });
      recorder.start(250);
      recStartedAt = Date.now();
      micTime.textContent = '0:00';
      setMicState('recording');
      recTimerId = window.setInterval(updateRecTimer, 250);
    }

    function stopRec() {
      if (!recorder) return;
      try { recorder.stop(); } catch {}
    }

    async function transcribe(blob: Blob) {
      setMicState('transcribing');
      const fd = new FormData();
      fd.set('audio', blob, 'voice.webm');
      try {
        const res = await fetch('/api/transcribe', { method: 'POST', body: fd });
        if (res.status === 503) {
          setMicState('idle');
          input.value = (input.value + ' ').trim();
          input.placeholder = 'Voice-in is not configured (set API_ELEVENLABS).';
          setTimeout(() => { input.placeholder = 'Ask the HackerX assistant…'; }, 3500);
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as { text?: string };
        const text = (data.text ?? '').trim();
        if (text) {
          const before = input.value.trim();
          input.value = before ? `${before} ${text}` : text;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
          input.setSelectionRange(input.value.length, input.value.length);
        }
        setMicState('idle');
      } catch (err) {
        console.error('transcribe', err);
        setMicState('idle');
        input.placeholder = 'Couldn\'t transcribe — try again.';
        setTimeout(() => { input.placeholder = 'Ask the HackerX assistant…'; }, 2400);
      }
    }

    mic.addEventListener('click', () => {
      if (mic.dataset.state === 'recording') stopRec();
      else if (mic.dataset.state !== 'transcribing') startRec();
    });

    loadHistory();
    rerender();
  })();
</script>

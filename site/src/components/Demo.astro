---
interface Props {
  speaker: 'user' | 'claude';
  turn?: string | number;
}

const { speaker, turn } = Astro.props;
---

<div class={`hx-demo hx-demo-${speaker}`}>
  <header class="hx-demo-header">
    {turn !== undefined && <span class="hx-demo-turn">Turn {turn}</span>}
    <span class="hx-demo-speaker">{speaker === 'user' ? 'You' : 'Claude'}</span>
  </header>
  <div class="hx-demo-body"><slot /></div>
</div>

<style>
  .hx-demo {
    margin-block: 1rem;
    padding: 0.75rem 1rem 1rem;
    border-left: 3px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
    border-radius: 0 0.375rem 0.375rem 0;
  }
  .hx-demo-claude {
    border-left-color: var(--sl-color-text-accent);
  }
  .hx-demo-user {
    border-left-color: var(--sl-color-gray-3);
  }
  .hx-demo-header {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hx-demo-turn {
    color: var(--sl-color-gray-3);
  }
  .hx-demo-speaker {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .hx-demo-user .hx-demo-speaker {
    color: var(--sl-color-gray-2);
  }
  .hx-demo-body :global(p:first-child) {
    margin-top: 0;
  }
  .hx-demo-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>

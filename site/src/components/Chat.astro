---
/**
 * Floating chatbot launcher rendered into the footer on every page.
 * Calls /api/chat (Anthropic Claude Haiku 4.5) with streaming.
 */
---

<div id="hx-chat-root" data-state="closed">
  <button type="button" id="hx-chat-launcher" aria-label="Ask the HackerX assistant" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>Ask Claude</span>
  </button>

  <section id="hx-chat-panel" role="dialog" aria-label="HackerX assistant" aria-modal="false" hidden>
    <header class="hx-chat-header">
      <div class="hx-chat-title">
        <span class="hx-chat-dot" aria-hidden="true"></span>
        <h2>HackerX assistant</h2>
        <span class="hx-chat-model">Claude Haiku 4.5</span>
      </div>
      <button type="button" class="hx-chat-close" id="hx-chat-close" aria-label="Close chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="hx-chat-log" id="hx-chat-log" role="log" aria-live="polite" aria-label="Chat messages">
      <div class="hx-chat-empty" data-empty>
        <p>Ask about the patterns, prompts, or workflow.</p>
        <ul class="hx-chat-suggestions">
          <li><button type="button" class="hx-chat-suggest" data-suggest="What pattern fits a settings page that feels cluttered?">What pattern fits a settings page that feels cluttered?</button></li>
          <li><button type="button" class="hx-chat-suggest" data-suggest="How do I install the ui-pattern-picker skill?">How do I install the ui-pattern-picker skill?</button></li>
          <li><button type="button" class="hx-chat-suggest" data-suggest="Give me the 8-step OS as a paste-into-CLAUDE.md block.">Give me the 8-step OS as a paste-into-CLAUDE.md block.</button></li>
        </ul>
      </div>
    </div>

    <form class="hx-chat-form" id="hx-chat-form">
      <label class="hx-chat-input-wrap">
        <span class="sr-only">Your question</span>
        <textarea
          id="hx-chat-input"
          name="message"
          rows="1"
          placeholder="Ask the HackerX assistant..."
          autocomplete="off"
          required
          maxlength="4000"
        ></textarea>
      </label>
      <button type="submit" class="hx-chat-send" aria-label="Send">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <footer class="hx-chat-foot">
      <span>Streaming via Anthropic. Verify before shipping.</span>
      <button type="button" class="hx-chat-clear" id="hx-chat-clear" aria-label="Clear conversation">Clear</button>
    </footer>
  </section>
</div>

<style>
  #hx-chat-root {
    position: fixed;
    inset: auto 1rem 1rem auto;
    z-index: 9999;
    font-family: var(--__sl-font-system, system-ui), sans-serif;
    color: var(--sl-color-text);
  }

  #hx-chat-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(16, 185, 129, 0.4);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  #hx-chat-launcher:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24), 0 0 0 1px rgba(16, 185, 129, 0.6);
  }
  #hx-chat-launcher:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 3px;
  }
  #hx-chat-root[data-state='open'] #hx-chat-launcher {
    display: none;
  }

  #hx-chat-panel {
    width: 380px;
    max-width: calc(100vw - 2rem);
    height: 540px;
    max-height: calc(100vh - 2rem);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #hx-chat-panel[hidden] {
    display: none;
  }

  .hx-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    background: var(--sl-color-bg-sidebar);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .hx-chat-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hx-chat-title h2 {
    font-size: 0.9rem;
    margin: 0;
  }
  .hx-chat-dot {
    width: 8px;
    height: 8px;
    background: var(--sl-color-text-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--sl-color-text-accent);
    animation: hx-chat-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hx-chat-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .hx-chat-model {
    font-family: var(--__sl-font-mono);
    font-size: 0.65rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hx-chat-close {
    background: transparent;
    border: 0;
    color: var(--sl-color-gray-2);
    padding: 0.25rem;
    cursor: pointer;
    border-radius: 0.25rem;
  }
  .hx-chat-close:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
  }

  .hx-chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-behavior: smooth;
  }
  .hx-chat-empty {
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
  }
  .hx-chat-empty p {
    margin: 0 0 0.75rem;
  }
  .hx-chat-suggestions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hx-chat-suggest {
    width: 100%;
    text-align: left;
    padding: 0.45rem 0.625rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .hx-chat-suggest:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .hx-chat-msg {
    max-width: 92%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .hx-chat-msg.user {
    align-self: flex-end;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border-bottom-right-radius: 0.125rem;
  }
  .hx-chat-msg.assistant {
    align-self: flex-start;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-left-radius: 0.125rem;
  }
  .hx-chat-msg.assistant pre {
    margin: 0.5rem 0;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    overflow-x: auto;
    white-space: pre;
  }
  .hx-chat-msg.assistant code:not(pre code) {
    padding: 0.0625rem 0.3rem;
    background: var(--sl-color-bg-inline-code);
    border-radius: 0.25rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.85em;
  }
  .hx-chat-msg.assistant a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .hx-chat-msg p {
    margin: 0 0 0.5rem;
  }
  .hx-chat-msg p:last-child {
    margin-bottom: 0;
  }
  .hx-chat-msg.error {
    align-self: flex-start;
    background: transparent;
    border: 1px dashed #b91c1c;
    color: #ef4444;
    font-size: 0.8rem;
  }

  .hx-chat-cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 1px;
    background: var(--sl-color-text-accent);
    vertical-align: text-bottom;
    animation: hx-chat-blink 1s steps(2) infinite;
  }
  @keyframes hx-chat-blink {
    50% { opacity: 0; }
  }

  .hx-chat-form {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
  }
  .hx-chat-input-wrap {
    flex: 1;
    display: block;
  }
  .hx-chat-form textarea {
    width: 100%;
    min-height: 38px;
    max-height: 120px;
    padding: 0.5rem 0.625rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.85rem;
    resize: none;
    line-height: 1.4;
  }
  .hx-chat-form textarea:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .hx-chat-send {
    align-self: stretch;
    width: 38px;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border: 0;
    border-radius: 0.375rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hx-chat-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hx-chat-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.75rem;
    background: var(--sl-color-bg-sidebar);
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }
  .hx-chat-clear {
    background: transparent;
    border: 0;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    text-decoration: underline;
    font: inherit;
    font-size: 0.7rem;
  }
  .hx-chat-clear:hover {
    color: var(--sl-color-text);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 640px) {
    #hx-chat-root {
      inset: auto 0.75rem 0.75rem auto;
    }
    #hx-chat-panel {
      width: calc(100vw - 1.5rem);
      height: calc(100vh - 6rem);
      max-height: 80vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hx-chat-dot,
    .hx-chat-cursor {
      animation: none;
    }
  }
</style>

<script>
  (() => {
    const rootEl = document.getElementById('hx-chat-root') as HTMLElement | null;
    const launcherEl = document.getElementById('hx-chat-launcher') as HTMLButtonElement | null;
    const panelEl = document.getElementById('hx-chat-panel') as HTMLElement | null;
    const closeEl = document.getElementById('hx-chat-close') as HTMLButtonElement | null;
    const logEl = document.getElementById('hx-chat-log') as HTMLElement | null;
    const formEl = document.getElementById('hx-chat-form') as HTMLFormElement | null;
    const inputEl = document.getElementById('hx-chat-input') as HTMLTextAreaElement | null;
    const clearEl = document.getElementById('hx-chat-clear') as HTMLButtonElement | null;

    if (!rootEl || !launcherEl || !panelEl || !closeEl || !logEl || !formEl || !inputEl || !clearEl) return;
    const root = rootEl;
    const launcher = launcherEl;
    const panel = panelEl;
    const closeBtn = closeEl;
    const log = logEl;
    const form = formEl;
    const input = inputEl;
    const clearBtn = clearEl;

    const STORAGE_KEY = 'hx_chat_history_v1';
    type Msg = { role: 'user' | 'assistant'; content: string };
    let history: Msg[] = [];
    let inFlight: AbortController | null = null;

    function loadHistory() {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (raw) history = JSON.parse(raw);
      } catch {
        history = [];
      }
    }

    function saveHistory() {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-20)));
      } catch {
        // sessionStorage may be disabled — silently ignore
      }
    }

    // Tiny markdown renderer: code fences + inline code + links + line breaks. No HTML.
    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    function renderMarkdown(text: string): string {
      const blocks: string[] = [];
      let working = text.replace(/```([\w-]*)\n([\s\S]*?)```/g, (_m, _lang, code) => {
        const i = blocks.length;
        blocks.push(`<pre><code>${escapeHtml(code)}</code></pre>`);
        return `␀BLOCK${i}␀`;
      });
      working = escapeHtml(working);
      working = working.replace(/`([^`]+)`/g, (_m, code) => `<code>${code}</code>`);
      working = working.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g, (_m, label, href) => {
        const safe = href.startsWith('http') ? `${href}" target="_blank" rel="noopener` : href;
        return `<a href="${safe}">${label}</a>`;
      });
      working = working.replace(/\n\n+/g, '</p><p>').replace(/\n/g, '<br/>');
      working = `<p>${working}</p>`;
      working = working.replace(/␀BLOCK(\d+)␀/g, (_m, i) => blocks[Number(i)] ?? '');
      return working;
    }

    function rerender() {
      log.innerHTML = '';
      if (history.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'hx-chat-empty';
        empty.dataset.empty = '';
        empty.innerHTML = `
          <p>Ask about the patterns, prompts, or workflow.</p>
          <ul class="hx-chat-suggestions">
            <li><button type="button" class="hx-chat-suggest" data-suggest="What pattern fits a settings page that feels cluttered?">What pattern fits a settings page that feels cluttered?</button></li>
            <li><button type="button" class="hx-chat-suggest" data-suggest="How do I install the ui-pattern-picker skill?">How do I install the ui-pattern-picker skill?</button></li>
            <li><button type="button" class="hx-chat-suggest" data-suggest="Give me the 8-step OS as a paste-into-CLAUDE.md block.">Give me the 8-step OS as a paste-into-CLAUDE.md block.</button></li>
          </ul>`;
        log.appendChild(empty);
        return;
      }
      for (const m of history) {
        const el = document.createElement('div');
        el.className = `hx-chat-msg ${m.role}`;
        el.innerHTML = m.role === 'assistant' ? renderMarkdown(m.content) : escapeHtml(m.content);
        log.appendChild(el);
      }
      log.scrollTop = log.scrollHeight;
    }

    function open() {
      panel.hidden = false;
      root.dataset.state = 'open';
      launcher.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => input.focus());
    }
    function close() {
      panel.hidden = true;
      root.dataset.state = 'closed';
      launcher.setAttribute('aria-expanded', 'false');
      if (inFlight) inFlight.abort();
      launcher.focus();
    }

    launcher.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.state === 'open') close();
    });
    clearBtn.addEventListener('click', () => {
      if (inFlight) inFlight.abort();
      history = [];
      saveHistory();
      rerender();
      input.focus();
    });

    log.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.classList.contains('hx-chat-suggest')) {
        const text = t.dataset.suggest ?? '';
        if (text) {
          input.value = text;
          form.requestSubmit();
        }
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || inFlight) return;

      history.push({ role: 'user', content: text });
      saveHistory();
      input.value = '';
      input.style.height = 'auto';

      // Render user msg + placeholder for assistant streaming
      const userEl = document.createElement('div');
      userEl.className = 'hx-chat-msg user';
      userEl.textContent = text;
      const empty = log.querySelector('[data-empty]');
      if (empty) empty.remove();
      log.appendChild(userEl);
      const assistantEl = document.createElement('div');
      assistantEl.className = 'hx-chat-msg assistant';
      assistantEl.innerHTML = '<p><span class="hx-chat-cursor"></span></p>';
      log.appendChild(assistantEl);
      log.scrollTop = log.scrollHeight;

      inFlight = new AbortController();
      let assistantText = '';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
          signal: inFlight.signal,
        });

        if (res.status === 503) {
          assistantEl.classList.add('error');
          assistantEl.textContent = 'Chat is not configured on this deployment. Set ANTHROPIC_API_KEY to enable.';
          history.pop(); // drop the user msg from durable history since we never got a reply
          saveHistory();
          inFlight = null;
          return;
        }
        if (!res.ok || !res.body) {
          throw new Error(`HTTP ${res.status}`);
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          let idx: number;
          while ((idx = buffer.indexOf('\n\n')) !== -1) {
            const event = buffer.slice(0, idx);
            buffer = buffer.slice(idx + 2);
            const line = event.split('\n').find((l) => l.startsWith('data: '));
            if (!line) continue;
            const payload = line.slice(6).trim();
            if (payload === '[DONE]') {
              if (assistantText) history.push({ role: 'assistant', content: assistantText });
              saveHistory();
              continue;
            }
            try {
              const parsed = JSON.parse(payload) as { text?: string; error?: string };
              if (parsed.text) {
                assistantText += parsed.text;
                assistantEl.innerHTML = renderMarkdown(assistantText) + '<span class="hx-chat-cursor"></span>';
                log.scrollTop = log.scrollHeight;
              } else if (parsed.error) {
                throw new Error(parsed.error);
              }
            } catch (parseErr) {
              console.warn('chat parse', parseErr);
            }
          }
        }
        assistantEl.innerHTML = renderMarkdown(assistantText);
      } catch (err) {
        if ((err as Error).name === 'AbortError') {
          assistantEl.innerHTML = renderMarkdown(assistantText) || '<em>cancelled</em>';
        } else {
          console.error(err);
          assistantEl.classList.add('error');
          assistantEl.textContent = 'Could not reach the chat backend. Try again in a moment.';
          history.pop();
          saveHistory();
        }
      } finally {
        inFlight = null;
      }
    });

    loadHistory();
    rerender();
  })();
</script>

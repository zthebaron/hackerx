---
import Default from '@astrojs/starlight/components/Footer.astro';
import Chat from './Chat.astro';
---

<Default><slot /></Default>

<div class="hx-footer">
  <p class="hx-footer-attr">
    Built by <a href="https://digitalboutique.ai" rel="noopener">DBAI</a>
    · Architect <a href="https://digitalboutique.ai" rel="noopener">Tim De Vallee</a>
  </p>
  <ul class="hx-footer-links" aria-label="Connect">
    <li>
      <a
        href="https://www.linkedin.com/in/tim-de-vall%C3%A9e-50426759/"
        rel="noopener"
        target="_blank"
        aria-label="Tim De Vallee on LinkedIn"
        class="hx-footer-icon"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.86 3.37-1.86 3.6 0 4.27 2.37 4.27 5.45v6.3zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.99 0 1.78-.77 1.78-1.73V1.72C24 .77 23.21 0 22.22 0z"/>
        </svg>
        <span>LinkedIn</span>
      </a>
    </li>
    <li>
      <a href="https://github.com/zthebaron/hackerx" rel="noopener" aria-label="HackerX on GitHub" class="hx-footer-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58V21.1c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.31 1.23a11.5 11.5 0 0 1 6.02 0c2.3-1.55 3.31-1.23 3.31-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.69.83.58A12 12 0 0 0 12 .3"/>
        </svg>
        <span>GitHub</span>
      </a>
    </li>
    <li>
      <a
        href="https://github.com/zthebaron/hackerx/blob/main/LICENSE"
        rel="noopener"
        target="_blank"
        aria-label="Released under the MIT License"
        class="hx-footer-license-badge"
      >
        <svg viewBox="0 0 88 28" aria-hidden="true" class="hx-license-svg">
          <rect x="0.5" y="0.5" width="87" height="27" rx="6" fill="none" stroke="currentColor" stroke-width="1"/>
          <rect x="0.5" y="0.5" width="35" height="27" rx="6" fill="currentColor" fill-opacity="0.92"/>
          <text x="18" y="18.5" text-anchor="middle" font-family="ui-monospace, 'SF Mono', monospace" font-size="11" font-weight="800" fill="var(--sl-color-bg)" letter-spacing="0.05em">MIT</text>
          <text x="61" y="18" text-anchor="middle" font-family="ui-monospace, 'SF Mono', monospace" font-size="9" font-weight="600" fill="currentColor" letter-spacing="0.06em">LICENSE</text>
        </svg>
      </a>
    </li>
    <li>
      <a href="/blog/" aria-label="HackerX blog" class="hx-footer-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        <span>Blog</span>
      </a>
    </li>
    <li>
      <a href="/links/" aria-label="DBAI partner sites and tools" class="hx-footer-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/>
          <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/>
        </svg>
        <span>Network</span>
      </a>
    </li>
  </ul>
  <p class="hx-footer-tag">Stop saying "make it better." Pick a pattern.</p>

  <a class="hx-anthropic" href="https://www.anthropic.com/claude-code" rel="noopener" target="_blank" aria-label="Created with Claude Code from Anthropic">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="hx-anthropic-mark">
      <path
        fill="currentColor"
        d="M12 2 L13.4 8.6 L20 7.2 L15.4 12 L20 16.8 L13.4 15.4 L12 22 L10.6 15.4 L4 16.8 L8.6 12 L4 7.2 L10.6 8.6 Z"
      />
    </svg>
    <span class="hx-anthropic-label">
      <span class="hx-anthropic-eyebrow">Created with</span>
      <span class="hx-anthropic-name">Claude Code</span>
    </span>
    <span class="hx-anthropic-by">by Anthropic</span>
  </a>
</div>

<Chat />

<style>
  .hx-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    text-align: center;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .hx-footer-attr a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .hx-footer-attr a:hover {
    text-decoration: underline;
  }
  .hx-footer-tag {
    margin-top: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    letter-spacing: 0.02em;
  }
  .hx-footer-links {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .hx-footer-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease, transform 120ms ease;
  }
  .hx-footer-icon:hover {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
    transform: translateY(-1px);
  }
  .hx-footer-icon svg {
    flex-shrink: 0;
  }
  .hx-footer-license-badge {
    display: inline-flex;
    align-items: center;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    border-radius: 6px;
    transition: transform 120ms ease;
  }
  .hx-footer-license-badge:hover {
    transform: translateY(-1px);
  }
  .hx-footer-license-badge:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .hx-license-svg {
    height: 26px;
    width: auto;
    display: block;
  }
  .hx-anthropic {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.45rem 0.85rem;
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .hx-anthropic:hover {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }
  .hx-anthropic-mark {
    flex-shrink: 0;
  }
  .hx-anthropic-label {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.05;
    text-align: left;
  }
  .hx-anthropic-eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }
  .hx-anthropic-name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hx-anthropic-by {
    padding-left: 0.5rem;
    margin-left: 0.4rem;
    border-left: 1px solid var(--sl-color-gray-5);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
</style>

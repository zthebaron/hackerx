---
interface Props {
  /** Time in the status bar (default 9:41) */
  time?: string;
}
const { time = '9:41' } = Astro.props;
---

<figure class="hx-phone">
  <div class="hx-phone-shell">
    <div class="hx-phone-notch" aria-hidden="true"></div>
    <div class="hx-phone-status">
      <span class="hx-phone-time">{time}</span>
      <span class="hx-phone-icons" aria-hidden="true">
        <svg width="16" height="11" viewBox="0 0 16 11" fill="currentColor"><rect x="0" y="6" width="3" height="5" rx="1"/><rect x="4" y="4" width="3" height="7" rx="1"/><rect x="8" y="2" width="3" height="9" rx="1"/><rect x="12" y="0" width="3" height="11" rx="1"/></svg>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor"><path d="M7 9.5l-7-5C2 1.5 4.5 0 7 0s5 1.5 7 4.5l-7 5z" opacity="0.85"/></svg>
        <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="0.5" y="0.5" width="18" height="9" rx="2"/><rect x="2" y="2" width="14" height="6" rx="1" fill="currentColor"/><rect x="19.5" y="3" width="1.5" height="4" rx="0.5" fill="currentColor"/></svg>
      </span>
    </div>
    <div class="hx-phone-viewport">
      <slot />
    </div>
    <div class="hx-phone-handle" aria-hidden="true"></div>
  </div>
</figure>

<style>
  .hx-phone {
    margin: 0;
    display: flex;
    justify-content: center;
  }
  .hx-phone-shell {
    width: 320px;
    height: 660px;
    background: #0a0a0a;
    border-radius: 44px;
    border: 8px solid #1c1917;
    padding: 0;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.45),
      0 0 0 2px #292524,
      inset 0 0 0 2px rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: hidden;
  }
  .hx-phone-notch {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 26px;
    background: #0a0a0a;
    border-radius: 0 0 18px 18px;
    z-index: 2;
  }
  .hx-phone-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px 6px;
    color: var(--hx-phone-status-color, #0f172a);
    background: var(--hx-phone-status-bg, transparent);
    font: 600 0.75rem var(--__sl-font-system, system-ui);
  }
  .hx-phone-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .hx-phone-time {
    letter-spacing: -0.02em;
  }
  .hx-phone-viewport {
    height: calc(660px - 16px - 38px - 6px);
    overflow: hidden;
    background: var(--hx-phone-bg, #fafafa);
    color: var(--hx-phone-text, #0f172a);
  }
  .hx-phone-handle {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 4px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 2px;
  }
</style>

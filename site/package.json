{
  "name": "hackerx-site",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "HackerX — the course at hackerx.app",
  "scripts": {
    "dev": "pnpm sync && astro dev",
    "start": "astro dev",
    "sync": "tsx scripts/build-content.ts && tsx scripts/build-og.ts",
    "prebuild": "pnpm sync",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:links": "lychee --no-progress --offline --include-fragments 'dist/**/*.html'",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@astrojs/check": "^0.9.9",
    "@astrojs/starlight": "^0.39.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vercel": "^10.0.6",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.3.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^1.3.1",
    "lighthouse": "^12.3.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

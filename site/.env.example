# HackerX site environment variables
# Copy to .env.local for local development; configure in Vercel for production.

# Base URL of the deployed site (used for OG, sitemap, canonical, the OAuth return
# URL, and the default origin allowlist for the /api routes)
SITE_URL=https://hackerx.app

# Comma-separated origin allowlist for /api/chat, /api/tts, /api/transcribe.
# Leave blank to accept SITE_URL + localhost + this project's *.vercel.app previews.
ALLOWED_ORIGINS=

# HMAC key for signing assistant turns replayed by the chat client.
# Optional — falls back to ANTHROPIC_API_KEY. Rotating it just drops prior context.
CHAT_SIGNING_SECRET=

# Resend (newsletter signup) — leave blank to disable the form
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Supabase (deferred for v2 — progress tracking) — leave blank to disable
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (deferred for v2) — leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (footer chatbot)
# NOTE: the in-code rate limit in src/lib/guard.ts is per warm function instance,
# so it bounds a single abusive client, not a distributed one. Pair it with a
# Vercel Firewall rate-limit rule on /api/* and a hard monthly spend cap in the
# Anthropic and ElevenLabs dashboards.
ANTHROPIC_API_KEY=

# ElevenLabs (text-to-speech for the chatbot)
API_ELEVENLABS=
ELEVENLABS_VOICE_ID=

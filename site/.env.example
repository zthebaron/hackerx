# HackerX site environment variables
# Copy to .env.local for local development; configure in Vercel for production.

# Base URL of the deployed site (used for OG, sitemap, canonical)
SITE_URL=https://hackerx.app

# Resend (newsletter signup) — leave blank to disable the form
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Supabase (deferred for v2 — progress tracking) — leave blank to disable
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (deferred for v2) — leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (deferred for v2 — playground)
ANTHROPIC_API_KEY=

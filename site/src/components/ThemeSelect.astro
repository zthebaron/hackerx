---
/**
 * Override of Starlight's ThemeSelect.
 * Replaces the Auto/Light/Dark dropdown with a single sun/moon toggle button.
 *
 * Uses Starlight's own localStorage key (`starlight-theme`) so it stays compatible
 * with the rest of Starlight's theme machinery; setting `light` or `dark` opts out
 * of system-preference auto-following, which is what users expect from a binary toggle.
 */
---

<button
  class="hx-theme-toggle"
  type="button"
  aria-label="Toggle light and dark mode"
  data-hx-theme-toggle
>
  <svg class="hx-theme-icon hx-theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="hx-theme-icon hx-theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <span class="sr-only" data-hx-theme-label>Toggle theme</span>
</button>

<style>
  .hx-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
  }
  .hx-theme-toggle:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
    background: var(--sl-color-bg-inline-code);
  }
  .hx-theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .hx-theme-icon {
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .hx-theme-sun { display: none; }
  .hx-theme-moon { display: inline; }
  :global([data-theme='dark']) .hx-theme-sun { display: inline; }
  :global([data-theme='dark']) .hx-theme-moon { display: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'starlight-theme';
    const apply = (mode) => {
      const root = document.documentElement;
      if (mode === 'light' || mode === 'dark') {
        root.dataset.theme = mode;
      } else {
        delete root.dataset.theme;
      }
    };
    const getStored = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const store = (mode) => {
      try {
        localStorage.setItem(KEY, mode);
      } catch {
        // ignore
      }
    };
    const initial = getStored() || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    apply(initial);

    document.querySelectorAll('[data-hx-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        apply(next);
        store(next);
      });
    });
  })();
</script>

---
interface Props {
  /** Pretend URL shown in the browser chrome */
  url: string;
  /** Pretend tab title */
  title?: string;
  /** Optional class on the inner viewport */
  inner?: string;
}
const { url, title, inner } = Astro.props;
---

<figure class="hx-browser">
  <div class="hx-browser-chrome">
    <div class="hx-browser-dots" aria-hidden="true">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
    </div>
    <div class="hx-browser-tab">
      {title && <span class="hx-browser-title">{title}</span>}
    </div>
    <div class="hx-browser-url">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>{url}</span>
    </div>
    <div class="hx-browser-spacer"></div>
  </div>
  <div class={`hx-browser-viewport ${inner ?? ''}`.trim()}>
    <slot />
  </div>
</figure>

<style>
  .hx-browser {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35), 0 1px 0 rgba(255, 255, 255, 0.04) inset;
    background: var(--hx-frame-bg, #0c0a09);
    border: 1px solid var(--sl-color-gray-5);
  }
  .hx-browser-chrome {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--hx-frame-chrome, #1c1917);
    border-bottom: 1px solid var(--hx-frame-edge, rgba(255, 255, 255, 0.06));
  }
  .hx-browser-dots {
    display: flex;
    gap: 0.375rem;
  }
  .hx-browser-dots .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #3a3a3a;
  }
  .hx-browser-dots .dot-r { background: #ff5f57; }
  .hx-browser-dots .dot-y { background: #febc2e; }
  .hx-browser-dots .dot-g { background: #28c840; }
  .hx-browser-tab {
    display: flex;
    justify-content: center;
  }
  .hx-browser-title {
    font: 0.7rem var(--__sl-font-system, system-ui);
    color: rgba(255, 255, 255, 0.5);
  }
  .hx-browser-url {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.625rem;
    background: var(--hx-frame-urlbg, rgba(0, 0, 0, 0.4));
    border-radius: 999px;
    font-family: var(--__sl-font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: min(40ch, 60%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hx-browser-spacer {
    width: 36px;
  }
  .hx-browser-viewport {
    background: var(--hx-frame-vp, #ffffff);
    color: var(--hx-frame-text, #0f172a);
    min-height: 320px;
  }

  @media (max-width: 700px) {
    .hx-browser-chrome { grid-template-columns: auto 1fr auto; }
    .hx-browser-tab { display: none; }
  }
</style>
